# Scoped to the planned layout (see #1): Go server at the root, React + Vite app in web/.

# --- Go ---
/bin/
/dist/
/orrery
*.exe
*.test
*.out
coverage.*
go.work
go.work.sum

# Web build embedded into the binary with go:embed (generated by the web build)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# --- Web (web/) ---
/web/node_modules/
/web/dist/
/web/.vite/
/web/coverage/
/web/*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- Local config and secrets ---
.env
.env.*
!.env.example

# --- Local Docker data (docker compose volumes bound to the repo) ---
/data/

# --- Editors and OS ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# --- Claude Code (personal settings only; shared settings stay committed) ---
.claude/settings.local.json
