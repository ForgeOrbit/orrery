{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "vitest", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off"
  },
  "ignorePatterns": ["**/dist/**", "contract/**", "**/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["apps/server/src/features/**", "apps/web/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/*", "!../*/index.ts", "!../platform/**"],
                "message": "Import another feature only through its index.ts, never its internal files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/platform/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**", "../features", "../features/*"],
                "message": "platform/ must not import features. Features depend on the platform, not the other way round."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/*/*", "!**/features/*/index.ts"],
                "message": "Import a feature only through its index.ts, never its internal files."
              }
            ]
          }
        ]
      }
    }
  ]
}
