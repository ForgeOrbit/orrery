{
  "openapi": "3.1.0",
  "info": {
    "title": "Orrery API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "properties": {
          "setupComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "setupComplete"
        ]
      },
      "SetupAdminResponse": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          }
        },
        "required": [
          "email"
        ]
      },
      "Email": {
        "type": "string",
        "maxLength": 254
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "ProblemCode": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "detail"
        ]
      },
      "SetupAdminRequest": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "password": {
            "$ref": "#/components/schemas/NewPassword"
          }
        },
        "required": [
          "secret",
          "email",
          "password"
        ]
      },
      "NewPassword": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/LoginEmail"
          },
          "password": {
            "$ref": "#/components/schemas/LoginPassword"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginEmail": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "LoginPassword": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "emailVerified"
        ]
      },
      "SmtpSettingsResponse": {
        "type": "object",
        "properties": {
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "security": {
            "$ref": "#/components/schemas/SmtpSecurity"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasPassword": {
            "type": "boolean"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "host",
          "port",
          "security",
          "username",
          "hasPassword",
          "from"
        ]
      },
      "SmtpSecurity": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "none",
          "starttls",
          "tls",
          null
        ]
      },
      "SmtpSettings": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "security": {
            "$ref": "#/components/schemas/SmtpSecurity"
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "from": {
            "$ref": "#/components/schemas/Email"
          }
        },
        "required": [
          "host",
          "port",
          "security",
          "username",
          "password",
          "from"
        ]
      },
      "TestEmailResponse": {
        "type": "object",
        "properties": {
          "sentTo": {
            "$ref": "#/components/schemas/Email"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "sentTo",
          "message"
        ]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "token"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness: the process is up",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness: the database is reachable",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup/status": {
      "get": {
        "summary": "Whether initial setup (creating the first administrator) is complete",
        "responses": {
          "200": {
            "description": "Setup status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup/admin": {
      "post": {
        "summary": "Create the first system administrator and close setup",
        "description": "Requires the deployment-supplied bootstrap secret. Creates the administrator, its personal workspace, and the record that closes bootstrap, in one transaction. Exactly one attempt can ever succeed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupAdminRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Administrator created; setup is closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupAdminResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid secret, email, or password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The setup secret is wrong",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "No setup secret is configured on this installation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Setup is already complete",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Sign in with email and password",
        "description": "Accepts any non-empty email string and password by shape, and checks them against what is stored; wrong, unknown, or malformed credentials all answer the same 401. On success, sets the session cookie.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; the session cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request body is not JSON",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Wrong, unknown, or malformed email or password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "summary": "The account behind the browser's session cookie",
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/smtp": {
      "get": {
        "summary": "The installation's SMTP settings, without the password",
        "description": "System administrators only. Every field is null while SMTP has not been configured; hasPassword says whether a secret is stored without ever returning it.",
        "responses": {
          "200": {
            "description": "The saved settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmtpSettingsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Signed in, but not a system administrator",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace the installation's SMTP settings",
        "description": "System administrators only. Replaces the whole configuration, password included: the stored password is never returned, so an update supplies it again, and it is stored encrypted at rest (ADR-0004). An explicit null means no username or no password. Security 'none' refuses credentials, and a password requires the deployment's encryption key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmtpSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved settings, without the password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmtpSettingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "The settings are invalid, or security 'none' carries credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Signed in, but not a system administrator",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "No encryption key is configured for a password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/smtp/test": {
      "post": {
        "summary": "Send a test email to the administrator's own address",
        "description": "System administrators only, after SMTP is configured. The email carries a single-use token; redeeming it verifies the administrator's address. A delivery failure is a Problem whose code names the reason (smtp_unreachable, smtp_auth_failed, smtp_tls_failed, smtp_send_failed, smtp_password_unreadable).",
        "responses": {
          "200": {
            "description": "The test email was sent to the administrator's own address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEmailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Signed in, but not a system administrator",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "SMTP is not configured yet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The SMTP server refused the message; the code says why",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/email-verification": {
      "post": {
        "summary": "Redeem the verification token from the test email",
        "description": "For the signed-in account the token was issued to. The token is single-use and short-lived, and only this POST consumes it; opening the link in the email changes nothing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account, with its email verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The token is invalid, expired, already used, or issued to another account",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
