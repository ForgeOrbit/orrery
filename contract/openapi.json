    "/api/workspaces/{workspaceId}/invitations": {
      "post": {
        "summary": "Invite an email into a shared workspace",
        "description": "Owners only, and the inviter's email must be verified. A single-use link valid for seven days goes to the invited address. An existing account accepts it after signing in; a new address registers through it. Following the link (GET) changes nothing.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": true,
            "name": "workspaceId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
